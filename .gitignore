# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Example demo executables
examples/*/basic-demo
examples/*/comprehensive-demo
examples/*/enhanced-demo
examples/*/auth-and-security
examples/*/versioning-and-cache
examples/ef_migrations/ef_migrations_example
examples/ef_migrations/ef_migrations
examples/hybrid-migration-demo/hybrid_demo
examples/migration-example/migration_example

# Migration tool binaries
tools/migration/direct_runner
tools/migration/test_runner
tools/ef-migrate/ef-migrate

# Example migration files (generated during tests)
examples/*/test_migrations/
examples/**/test_migrations/

# Database files
*.db
*.sqlite
*.sqlite3

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.out
coverage.html
# Ignore HTML files except in docs
*.html
!docs/*.html
!docs/**/*.html

# npm logs and debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# Dependency directories (remove the comment below if you want to ignore vendor directory)
# vendor/
node_modules/

# Go workspace file
go.work

# SonarQube
.scannerwork/
.sonar/
sonar-project.properties.bak
.DS_Store
